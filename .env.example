PORT=3000
SESSION_SECRET=generate-a-random-string-here
DB_PATH=./livewave.db
# 32-byte key (64 hex chars) to encrypt TOTP secrets at rest. Generate: openssl rand -hex 32
# Optional in dev (secrets stored as-is if unset). After setting in prod, run:
#   node scripts/migrate-totp-encryption.js
TOTP_ENC_KEY=
